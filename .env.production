# Flask configuration for PRODUCTION
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=your_very_secure_secret_key_here_CHANGE_IN_PRODUCTION

# Database configuration
DATABASE_URI=sqlite:///concursos.db

# Admin user credentials (used for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123_CHANGE_IN_PRODUCTION

# Google Drive API Secure Token
# This token must match the one set in the Google Apps Script Properties
GOOGLE_DRIVE_SECURE_TOKEN=sT9k#mP2$vR5nL8*qX3wE7

# Google Drive CV Folder ID
# Create a folder in Google Drive for storing CVs and set its ID here
GOOGLE_DRIVE_CVS_FOLDER_ID=1depYWMQpIAnV12NxEzM-C-lQfyLIovd1

# Keycloak Configuration
KEYCLOAK_SERVER_URL=https://huayca.crub.uncoma.edu.ar/auth/
KEYCLOAK_REALM=CRUB
KEYCLOAK_CLIENT_ID=selecciones-docentes
KEYCLOAK_CLIENT_SECRET=TlMa1Jhk63JV57JKwH79oYR4XVxUq8zO
KEYCLOAK_ADMIN_CLIENT_ID=selecciones-docentes
KEYCLOAK_ADMIN_CLIENT_SECRET=TlMa1Jhk63JV57JKwH79oYR4XVxUq8zO

# Application Root Path Configuration - PRODUCTION SETTING
# This is the key setting for Apache deployment with base path
APPLICATION_ROOT=/concursos-docentes

# Static redirect URIs (will be overridden by dynamic URIs in production)
# These should match your Apache deployment domain
KEYCLOAK_REDIRECT_URI=https://huayca.crub.uncoma.edu.ar/concursos-docentes/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://huayca.crub.uncoma.edu.ar/concursos-docentes/

# Keycloak Role Configuration
KEYCLOAK_ADMIN_ROLE=app_admin
KEYCLOAK_TRIBUNAL_ROLE=tribunal_member

# Password Reset Configuration
USE_INTERNAL_PASSWORD_RESET=true
RESET_TOKEN_SECRET=your-very-secure-secret-key-here-CHANGE_IN_PRODUCTION

# Email method for password reset
# Options: redirect, custom_api, template, fallback
KEYCLOAK_EMAIL_METHOD=fallback

# Google Drive template document IDs are defined directly in app.gs
# You can update them there as needed

