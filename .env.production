# Production environment configuration for Keycloak integration
# Copy this to .env and update with your actual values

# Application configuration
APPLICATION_ROOT=/concursos-docentes
PRODUCTION_HOST=your-production-domain.com

# Flask configuration
SECRET_KEY=your-super-secure-secret-key-here
DATABASE_URI=sqlite:///concursos.db

# Keycloak Server Configuration
KEYCLOAK_SERVER_URL=https://huayca.crub.uncoma.edu.ar/auth/
KEYCLOAK_REALM=CRUB

# OIDC Client Configuration
KEYCLOAK_CLIENT_ID=flask-client
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# Admin API Configuration (optional - if you need admin functionality)
KEYCLOAK_ADMIN_CLIENT_ID=flask-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=your-keycloak-admin-client-secret

# Dynamic URL Configuration (these will be auto-generated if not set)
# KEYCLOAK_REDIRECT_URI=https://your-domain.com/concursos-docentes/auth/callback
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://your-domain.com/concursos-docentes/

# Role Configuration
KEYCLOAK_ADMIN_ROLE=app_admin
KEYCLOAK_TRIBUNAL_ROLE=tribunal_member

# Password Reset Configuration
USE_INTERNAL_PASSWORD_RESET=true

# Google Drive Configuration (if using)
GOOGLE_DRIVE_CVS_FOLDER_ID=your-google-drive-folder-id

# Admin User Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure-admin-password
